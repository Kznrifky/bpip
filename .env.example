# Salin ke .env. Tidak perlu dependency tambahan.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=data/bpip.sqlite3
BANK_NAME=BPIP Document Confirmation
# console: email disimpan sebagai .eml dan tersedia di Kotak Email Lokal.
# smtp: pengiriman otomatis menggunakan SMTP, STARTTLS atau TLS wajib.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TOKEN_TTL_HOURS=24
# Bootstrap akun pertama untuk deployment non-interaktif (opsional).
# Isi rahasia di dashboard hosting, hapus setelah akun pertama berhasil dibuat.
# BOOTSTRAP_USERS=1
# BOOTSTRAP_PETUGAS_EMAIL=
# BOOTSTRAP_PETUGAS_NAME=
# BOOTSTRAP_PETUGAS_PASSWORD=
# BOOTSTRAP_SOL_EMAIL=
# BOOTSTRAP_SOL_NAME=
# BOOTSTRAP_SOL_PASSWORD=
